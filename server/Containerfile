# armory-server.
#
# Built from the workspace root, because armory-server depends on armory-core
# by path:
#
#     podman build -f server/Containerfile -t armory-server .
#
# See `.dockerignore` at the root — without it this ships `target/`.

FROM docker.io/library/rust:1-slim-bookworm AS build

WORKDIR /build

# libsqlite3-dev, because `armory-core` takes rusqlite *without* the `bundled`
# feature — the lockfile's libsqlite3-sys pulls `pkg-config` and `vcpkg` and no
# `cc`, which is what "links the system library" looks like from the outside.
# So the store needs sqlite headers here and the shared library in the runtime
# stage. Turning `bundled` on would remove both lines and add a C compile of
# sqlite to every build; the platform already ships it.
RUN apt-get update \
 && apt-get install -y --no-install-recommends pkg-config libsqlite3-dev \
 && rm -rf /var/lib/apt/lists/*

# An explicit list rather than the whole context.
#
# `data/` is not the GTK shell's, whatever the name suggests.
# `core/src/place.rs` has `include_str!("../../data/zones.json")` with
# `data/instances.json` beside it, so the zone corpus is compiled into
# *armory-core* and therefore into everything that links it, this server
# included. Leaving it out fails at build time rather than at runtime, which is
# the good direction — but it fails a long way into a release build with an
# error about a missing file rather than a missing dependency, so it is worth
# knowing which line put it here.
COPY Cargo.toml Cargo.lock ./
COPY core ./core
COPY server ./server
COPY data ./data

# The GTK shell, as two empty files.
#
# Cargo will not parse a workspace whose root manifest declares a lib and a bin
# at paths that do not exist, and the root manifest here is the `armory`
# desktop application — so `src/lib.rs` and `src/main.rs` have to be there even
# though `-p armory-server` compiles neither.
#
# The real ones are not copied because the root `.dockerignore` excludes `src/`
# on purpose: that half is a megabyte of GTK code this image has no use for and
# no toolkit to build it against. Stubs satisfy the parse and ship nothing.
# **If cargo ever starts needing the shell's own sources**, the answer is to
# take `src/` out of `.dockerignore` and copy it, not to install gtk4 here.
RUN mkdir -p src \
 && : > src/lib.rs \
 && printf 'fn main() {}\n' > src/main.rs

# --locked so the image is built from the versions that were tested, and fails
# loudly if the lockfile and the manifests have drifted rather than quietly
# resolving something newer.
RUN cargo build --release --locked -p armory-server

FROM docker.io/library/debian:bookworm-slim

# libsqlite3-0 is the other half of the build stage's libsqlite3-dev: the
# binary links the system sqlite, so the runtime has to carry it. Without it
# the container exits immediately with a loader error, which reads like a
# corrupt image rather than a missing package.
#
# libssl and ca-certificates are not needed: this speaks plain HTTP to the
# tailnet and opens no outbound connection at all. Nothing here starts a TLS
# handshake, so nothing here carries a TLS stack.
RUN apt-get update \
 && apt-get install -y --no-install-recommends libgcc-s1 libsqlite3-0 \
 && rm -rf /var/lib/apt/lists/*

# A non-root user, which is right on an ordinary Docker host. On the Synology
# it is overridden back to root in the compose file — /volume1 carries ACLs
# that beat POSIX ownership, and a container uid that is not a DSM user cannot
# be granted write access through them. This image has a database on a bind
# mount, so that override is doing real work here rather than being kept for
# consistency. The comment there has the whole story.
RUN useradd --system --uid 10001 --no-create-home armory

# Where the SQLite file goes, and the only path this process writes. It is
# declared here so an image run with no mount at all still starts and keeps its
# account somewhere, rather than failing on a directory it could have made.
ENV ARMORY_DATA=/var/lib/armory
RUN mkdir -p /var/lib/armory && chown 10001:10001 /var/lib/armory

COPY --from=build /build/target/release/armory-server /usr/local/bin/armory-server

USER 10001:10001
EXPOSE 8084

# The image has no curl and no wget, and a healthcheck that needed the bearer
# token would mean handing the secret to Docker too. So the binary asks itself:
# `--health` connects to its own port and reads the status line.
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
    CMD ["/usr/local/bin/armory-server", "--health"]

ENTRYPOINT ["/usr/local/bin/armory-server"]
