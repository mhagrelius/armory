# Copy to `.env` beside this file and fill in. `.env` is gitignored.
#
# Container Manager reads a `.env` from the project folder, so this is uploaded
# beside compose.yaml on the NAS. There is no second job for it here — unlike
# planner, which shares one file with its migrations, armory-server has no
# database to set up. The account is a SQLite file the server makes itself on
# first start.

# --- Deployment -------------------------------------------------------------

# Where Container Manager pulls the image from — whatever the deploy script
# printed when it pushed.
#
# Say "localhost" even though the push went to the NAS's tailnet name. A
# registry stores repositories by name and not by hostname, so it is the same
# image, and Docker accepts a registry reached over localhost on plain HTTP
# without being configured to. Naming the NAS instead means editing the Docker
# daemon config over SSH for no gain.
#
# Pin the dated tag rather than :latest, so a restart cannot quietly change
# what is holding the account.
ARMORY_SERVER_IMAGE=localhost:5050/armory-server:2026-08-08

# 32 characters or more, or the server refuses to start rather than inventing
# one. The only thing between the tailnet and the account.
#     openssl rand -hex 32
ARMORY_TOKEN=

# Which interface to listen on. Leave it unset.
#
# Binding the NAS's Tailscale address would be better — this speaks plain HTTP,
# so on a LAN both the token and the account travel in clear text — but it
# cannot be done on the NAS. Tailscale runs there as a DSM package in userspace,
# so the 100.x.y.z address is not on any local interface and Docker refuses to
# start the container: `bind: cannot assign requested address`. brain-server and
# planner-server are bound the same way for the same reason.
#
# Set it on a host where the tailnet address is a real interface.
# ARMORY_BIND=100.x.y.z

# --- Not set here -----------------------------------------------------------
#
# ARMORY_ADDR and ARMORY_DATA are both written into the compose file rather
# than left to defaults, because each is half of a pair — the address has to
# match the published port, and the data path has to match the bind mount.
# Overriding one of them here without the other gives a container that starts,
# reports healthy, and keeps the account somewhere nothing is backing up.
#
# On the NAS the mount source must exist first:
#     /volume1/docker/armory-server/data
# Synology's Docker refuses to create it, where vanilla Docker would.
