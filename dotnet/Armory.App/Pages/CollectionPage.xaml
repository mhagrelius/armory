<Page
  x:Class="Armory.App.Pages.CollectionPage"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:local="using:Armory.App.Pages">
  <Page.Resources>
    <DataTemplate x:Key="TileTemplate" x:DataType="local:CollectionTile">
      <StackPanel Width="120" Margin="8" Spacing="6">
        <Grid>
          <Border Style="{StaticResource ArtBox}" Opacity="{x:Bind ArtOpacity}" HorizontalAlignment="Left">
            <Grid>
              <FontIcon Glyph="&#xE734;" FontSize="28" Opacity="0.22" HorizontalAlignment="Center" VerticalAlignment="Center" />
              <Image Source="{x:Bind Art, Mode=OneWay}" Stretch="UniformToFill" />
            </Grid>
          </Border>
          <Ellipse Width="14" Height="14" Fill="{ThemeResource AccentFillColorDefaultBrush}" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="76,0,0,-4" Visibility="{x:Bind Dot}" />
        </Grid>
        <TextBlock Text="{x:Bind Name}" Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap" MaxLines="2" />
        <TextBlock Text="{x:Bind Source}" Style="{StaticResource Caption}" MaxLines="2" />
      </StackPanel>
    </DataTemplate>
    <GroupStyle x:Key="SourceGroups">
      <GroupStyle.HeaderTemplate>
        <DataTemplate x:DataType="local:TileGroup">
          <TextBlock Text="{x:Bind Label}" Style="{StaticResource CardHeading}" Margin="8,12,8,0" />
        </DataTemplate>
      </GroupStyle.HeaderTemplate>
    </GroupStyle>
  </Page.Resources>
</Page>
