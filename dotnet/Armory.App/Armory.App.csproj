<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.22621.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <Platforms>x64</Platforms>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>false</WindowsAppSDKSelfContained>
    <RootNamespace>Armory.App</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets/Armory.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <!-- The window and taskbar icon is read from disk at runtime, so it ships
         as a loose file rather than as PRI-indexed content. -->
    <Content Remove="Assets/Armory.ico" />
    <None Include="Assets/Armory.ico" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../Armory.Core/Armory.Core.csproj" />
    <ProjectReference Include="../Armory.Client/Armory.Client.csproj" />
  </ItemGroup>
</Project>
